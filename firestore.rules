rules_version = '2';
// Ogni utente può leggere e scrivere solo i propri dati: users/{uid} e users/{uid}/episodes/{giorno}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /episodes/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
